function shuffleCards(){flashDeck=shuffle(flashBase);flashIndex=0;flashBack=false;renderCard();}
function renderCard(){
 const el=document.getElementById('flashcard'); if(!flashDeck.length)shuffleCards();
 el.className='flashcard'+(flashBack?' flashback':'');
 el.innerHTML=flashBack?`<div><b>答案</b><br><br>${escapeHtml(flashDeck[flashIndex][1])}</div>`:`<div><b>${escapeHtml(flashDeck[flashIndex][0])}</b><br><span class="small">點一下翻面</span></div>`;
 document.getElementById('flashcount').textContent=`${flashIndex+1} / ${flashDeck.length}`;
}
function flipCard(){flashBack=!flashBack;renderCard();}
function nextCard(){flashIndex=(flashIndex+1)%flashDeck.length;flashBack=false;renderCard();}
function prevCard(){flashIndex=(flashIndex-1+flashDeck.length)%flashDeck.length;flashBack=false;renderCard();}

// Podcast using iOS/browser speech synthesis
let podIndex=0, podStopped=true;
function loadVoices(){
 const sel=document.getElementById('voiceSel'); const voices=speechSynthesis.getVoices();
 const zh=voices.filter(v=>/^zh/i.test(v.lang)||/Chinese|Mandarin|國語|中文/i.test(v.name));
 const old=sel.value; sel.innerHTML='<option value="">自動選中文語音</option>'+zh.map(v=>`<option value="${escapeHtml(v.name)}">${escapeHtml(v.name)} (${v.lang})</option>`).join(''); if(old)sel.value=old;
}
function renderPodcastList(){
 const box=document.getElementById('podcastList');box.innerHTML=podcast.map((p,i)=>`<div class="podcast-track" id="pod-${i}"><b>${i+1}. ${escapeHtml(p.title)}</b><div class="small" style="color:#cbd5e1">${escapeHtml(p.text)}</div></div>`).join('');
}
function startPodcast(){stopPodcast();podStopped=false;podIndex=0;speakNext();}
function speakNext(){
 if(podStopped||podIndex>=podcast.length){document.getElementById('podcastStatus').textContent=podIndex>=podcast.length?'播放完畢 ✓':'已停止';return;}
 document.querySelectorAll('.podcast-track').forEach(x=>x.classList.remove('current')); const row=document.getElementById('pod-'+podIndex); if(row){row.classList.add('current');row.scrollIntoView({behavior:'smooth',block:'center'});}
 const u=new SpeechSynthesisUtterance(podcast[podIndex].title+'。'+podcast[podIndex].text);u.lang='zh-TW';u.rate=parseFloat(document.getElementById('rateSel').value||'1');
 const vn=document.getElementById('voiceSel').value; if(vn){const v=speechSynthesis.getVoices().find(x=>x.name===vn);if(v)u.voice=v;}
 u.onend=()=>{podIndex++;speakNext();};u.onerror=()=>{document.getElementById('podcastStatus').textContent='語音播放中斷，可再按開始。';};
 document.getElementById('podcastStatus').textContent=`播放中：${podIndex+1} / ${podcast.length}｜${podcast[podIndex].title}`;
 speechSynthesis.speak(u);
}
function pausePodcast(){speechSynthesis.pause();document.getElementById('podcastStatus').textContent='已暫停';}
function resumePodcast(){speechSynthesis.resume();document.getElementById('podcastStatus').textContent=`繼續播放：${podIndex+1} / ${podcast.length}`;}
function stopPodcast(){podStopped=true;speechSynthesis.cancel();document.querySelectorAll('.podcast-track').forEach(x=>x.classList.remove('current'));}
document.addEventListener('DOMContentLoaded',()=>{renderQuiz(20);updateWrongSummary();shuffleCards();renderPodcastList();loadVoices();});
if('speechSynthesis' in window) speechSynthesis.onvoiceschanged=loadVoices;
window.addEventListener('scroll',()=>{
 const h=document.documentElement.scrollHeight-innerHeight;
 document.getElementById('bar').style.width=(h?scrollY/h*100:0)+'%';
});
