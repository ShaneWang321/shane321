 22, "q": "領導行為理論主要關注 ________。", "opts": {"A": "有效領導者是誰", "B": "有效領導者具有哪些特徵", "C": "如何辨識有效領導者", "D": "有效領導者做了什麼"}, "answer": "D", "tag": "領導行為論", "explain": "行為論關心有效領導者『做了什麼』，不是他們天生具有什麼特質。"}, {"n": 23, "q": "在情境領導理論（SLT）中，準備度（readiness）是指執行任務的 ________。", "opts": {"A": "能力", "B": "意願", "C": "能力與意願兩者", "D": "個人的動機"}, "answer": "C", "tag": "情境領導", "explain": "SLT 的 readiness / maturity 由能力與意願共同構成。"}, {"n": 24, "q": "領導者激勵追隨者超越個人利益並創造非凡成就，且對追隨者績效產生深遠影響，這是哪一種領導型態？", "opts": {"A": "指導型領導者", "B": "資訊型領導者", "C": "交易型領導者", "D": "轉換型領導者"}, "answer": "D", "tag": "轉換型領導", "explain": "使追隨者超越個人利益並創造非凡成就，是轉換型領導的典型描述。"}, {"n": 25, "q": "哪一種類型的領導者較可能造成「過度領導、管理不足（over-leading and under-managing）」的現象？", "opts": {"A": "交易型", "B": "魅力型", "C": "特質型", "D": "轉換型"}, "answer": "B", "tag": "魅力型領導", "explain": "題庫把 over-leading and under-managing 對應到魅力型領導者。"}, {"n": 26, "q": "依工作特性模式（JCM）的定義，下列何者是指工作對他人生活或工作的重大影響程度？", "opts": {"A": "任務重要性（Task significance）", "B": "任務完整性（Task identity）", "C": "技能多樣性（Skill variety）", "D": "自主性（Autonomy）"}, "answer": "A", "tag": "工作特性", "explain": "題幹中的『對他人生活或工作的重大影響』就是 Task significance。"}, {"n": 27, "q": "依費德勒的觀點，當你的領導風格與情境不適配時，應該怎麼做？", "opts": {"A": "改變領導者風格", "B": "改變情境", "C": "改變風格或情境效果相同", "D": "改變獎酬制度"}, "answer": "B", "tag": "費德勒", "explain": "費德勒假設領導風格相對固定；不適配時應改變情境或更換領導者。"}, {"n": 28, "q": "下列哪一種領導型態可描述為提供較少指導與較少支持？", "opts": {"A": "指導型（Directing）", "B": "推銷型（Selling）", "C": "參與型（Participating）", "D": "授權型（Delegating）"}, "answer": "D", "tag": "情境領導", "explain": "高能力、高意願時，領導者可提供最低程度的指導與支持，即 Delegating。"}, {"n": 29, "q": "依費德勒研究，在最有利或最不利的情境下，哪一種領導行為最有效？", "opts": {"A": "任務導向", "B": "人際／關係導向", "C": "參與式", "D": "成就導向"}, "answer": "A", "tag": "費德勒", "explain": "費德勒模型中，情境非常有利或非常不利時，任務導向領導較有效。"}, {"n": 30, "q": "領導（Leadership）是 ________。", "opts": {"A": "一種過程", "B": "一種特質", "C": "一種可在領導者身上發現的魅力", "D": "以上皆是"}, "answer": "A", "tag": "領導定義", "explain": "講義定義領導為『影響他人朝預期目標邁進的過程』，因此最佳答案是 process。"}, {"n": 31, "q": "管理中的控制功能，很重要的一部分是 ________。", "opts": {"A": "制定策略", "B": "設定目標", "C": "修正績效問題", "D": "建立組織結構"}, "answer": "C", "tag": "控制", "explain": "控制的重點是發現偏差後修正績效問題，使工作回到計畫軌道。"}, {"n": 32, "q": "某汽車公司比起總銷售量，更重視品質衡量，這家公司最可能希望在 ________ 方面表現卓越。", "opts": {"A": "顧客滿意度", "B": "效率", "C": "員工滿意度", "D": "單位成本"}, "answer": "A", "tag": "控制衡量", "explain": "重視品質而非單純數量，最直接對應顧客滿意與價值，而非效率或單位成本。"}, {"n": 33, "q": "統計報告的一項缺點，是它可能忽略 ________ 的績效衡量。", "opts": {"A": "主觀性", "B": "客觀性", "C": "正面性", "D": "負面性"}, "answer": "A", "tag": "績效資訊來源", "explain": "統計報告擅長量化，但容易忽略主觀、非量化的績效面向。"}, {"n": 34, "q": "下列何者是最完整的績效衡量方式？", "opts": {"A": "走動式管理（MBWA）", "B": "口頭報告", "C": "圖表", "D": "書面報告"}, "answer": "D", "tag": "績效資訊來源", "explain": "講義指出書面報告最正式、最完整，且易於後續分類與查找。"}, {"n": 35, "q": "要執行控制程序的第二步，電動刮鬍刀公司的管理者應把實際銷售數量與 ________ 比較。", "opts": {"A": "競爭者的銷售總量", "B": "原先規劃的銷售目標", "C": "去年的銷售總量", "D": "潛在顧客人數"}, "answer": "B", "tag": "控制程序", "explain": "控制第二步是把實際績效與預設標準／規劃目標比較。"}, {"n": 36, "q": "當實際績效超出可接受的變異範圍時，稱為 ________。", "opts": {"A": "重大偏差（significant deviation）", "B": "不重大偏差", "C": "可接受偏差", "D": "大型偏差"}, "answer": "A", "tag": "控制程序", "explain": "超出可接受變異範圍即屬重大偏差 significant deviation。"}, {"n": 37, "q": "立即矯正行動（immediate corrective action）的目的在於 ________。", "opts": {"A": "找出問題根本原因", "B": "讓績效回到正軌", "C": "徹底重整組織", "D": "懲罰績效不佳員工"}, "answer": "B", "tag": "矯正行動", "explain": "立即矯正是先讓績效回到正軌；找根本原因屬較徹底的基本矯正。"}, {"n": 38, "q": "哪一種控制是在實際工作進行的同時發生？", "opts": {"A": "事後控制（feedback）", "B": "即時控制（concurrent）", "C": "反向控制", "D": "事前控制（feedforward）"}, "answer": "B", "tag": "控制類型", "explain": "工作正在進行時同步監督與修正＝即時控制 concurrent。"}, {"n": 39, "q": "動作影集在正式拍攝前，先針對尚未完成的劇本進行讀本，演員、編劇、製作人與導演可提出意見與修改。這屬於哪一種控制？", "opts": {"A": "事後控制", "B": "即時控制", "C": "自發控制", "D": "事前控制"}, "answer": "D", "tag": "控制類型", "explain": "正式拍攝前先讀本、提前找問題並修正＝事前控制 feedforward。"}, {"n": 40, "q": "平衡計分卡會在四個關鍵績效領域設定目標，並評估 ________。", "opts": {"A": "是否達成其中多數目標", "B": "四個目標是否全部達成", "C": "財務目標是否優於其他目標", "D": "哪些目標被超越"}, "answer": "B", "tag": "平衡計分卡", "explain": "題庫設定的答案是四個關鍵績效領域都要評估是否達成。"}, {"n": 41, "q": "高階管理者最能如何展現對企業倫理實務的承諾？", "opts": {"A": "採用並落實書面道德準則", "B": "閱讀員工電子郵件", "C": "採取分權決策", "D": "與其他公司合作", "E": "監控員工網路搜尋"}, "answer": "A", "tag": "企業倫理", "explain": "題庫重點：高階主管以採用並實際執行書面道德準則來展現倫理承諾。"}, {"n": 42, "q": "聘僱、解僱、工作條件、隱私與尊重等議題，屬於哪一類倫理？", "opts": {"A": "對經濟代理人的行為", "B": "對員工的行為", "C": "對組織的行為", "D": "消除利益衝突", "E": "社會責任"}, "answer": "B", "tag": "企業倫理", "explain": "聘僱、解僱、工作條件、隱私與尊重，都直接屬於對員工的倫理議題。"}, {"n": 43, "q": "Woojin 是新進員工，希望自己的所有行為都能支持組織核心原則與價值。他最適合從哪裡了解組織特別重視的價值與原則？", "opts": {"A": "大專院校", "B": "已離職的高階主管", "C": "組織中的同儕", "D": "書面準則與政策", "E": "小型企業管理局"}, "answer": "D", "tag": "企業倫理", "explain": "若要知道組織正式宣示的核心原則，題庫指向書面準則與政策。"}, {"n": 44, "q": "直接受到組織實務影響的群體、個人與組織，稱為什麼？", "opts": {"A": "主要利益代理人", "B": "社會稽核者", "C": "競爭者", "D": "組織利害關係人", "E": "地方社區"}, "answer": "D", "tag": "利害關係人", "explain": "題幹直接描述『受到組織實務影響的群體、個人與組織』，即 organizational stakeholders。"}, {"n": 45, "q": "每家公司在維持與報告財務狀況時，都必須做到什麼？", "opts": {"A": "以融資方式買股票", "B": "採用創意會計", "C": "支持股價上升", "D": "追求預測利潤率最大化", "E": "遵循一般公認會計原則"}, "answer": "E", "tag": "企業倫理", "explain": "題庫以遵循一般公認會計原則作為財務報告的基本要求。"}, {"n": 46, "q": "製造工廠排放的一氧化碳會造成哪一類污染？", "opts": {"A": "噪音污染", "B": "土地污染", "C": "水污染", "D": "空氣污染", "E": "廢棄物污染"}, "answer": "D", "tag": "社會責任", "explain": "一氧化碳由工廠排放到大氣，題庫歸類為空氣污染。"}, {"n": 47, "q": "下列哪一機構規範廣告與定價行為，以保護消費者？", "opts": {"A": "一般公認會計原則", "B": "北美自由貿易協定", "C": "食品藥物管理局", "D": "聯邦貿易委員會（FTC）", "E": "兒童線上隱私保護法"}, "answer": "D", "tag": "消費者保護", "explain": "題庫答案：聯邦貿易委員會 FTC 負責廣告與定價實務的消費者保護。"}, {"n": 48, "q": "企業真誠希望改善社會福祉，並主動尋找對社會做出正面貢獻的機會，屬於哪一種社會責任立場？", "opts": {"A": "阻礙型", "B": "調適型", "C": "社會調適", "D": "防禦型", "E": "主動型（Proactive）"}, "answer": "E", "tag": "社會責任", "explain": "主動尋找改善社會福祉機會，對應 proactive 主動型立場。"}, {"n": 49, "q": "政府可用哪一種「間接規範」方式影響企業社會責任？", "opts": {"A": "制定法律", "B": "支持股東", "C": "對違規者處以罰款", "D": "提供稅賦誘因", "E": "與外國政府合作"}, "answer": "D", "tag": "社會責任", "explain": "題庫將稅賦誘因視為政府的間接規範方式。"}, {"n": 50, "q": "下列何者最能支持組織在社會責任與倫理領導上的立場？", "opts": {"A": "慈善捐贈", "B": "組織領導實務", "C": "直線與幕僚成員", "D": "利害關係人", "E": "政府介入"}, "answer": "B", "tag": "倫理領導", "explain": "題庫強調組織領導實務最能持續支持其社會責任與倫理立場。"}, {"n": 51, "q": "人力資源管理（HRM）程序最前面的三項活動主要與 ________ 有關。", "opts": {"A": "招募", "B": "規劃", "C": "訓練", "D": "縮編"}, "answer": "B", "tag": "人力資源", "explain": "題庫把 HRM 前三項活動歸為規劃面向。"}, {"n": 52, "q": "一般而言，________ 都會參與自己部門或單位的人力資源決策。", "opts": {"A": "極少數管理者", "B": "部分管理者", "C": "大多數管理者", "D": "所有管理者"}, "answer": "D", "tag": "人力資源", "explain": "人力決策並非只有 HR 部門；題庫答案是所有管理者都會參與自己單位的 HR 決策。"}, {"n": 53, "q": "下列何者「不應」成為影響薪酬與福利的因素？", "opts": {"A": "性別", "B": "年資", "C": "地理位置", "D": "員工績效水準"}, "answer": "A", "tag": "薪酬", "explain": "性別不應成為薪酬福利差異的正當因素。"}, {"n": 54, "q": "Rolland 的部門有職缺且需要快速補人。他要去哪裡找到具備合適技能、又熟悉組織及其價值觀的人？", "opts": {"A": "員工資訊系統", "B": "線上求職網站", "C": "政府就業機構", "D": "競爭者"}, "answer": "A", "tag": "招募", "explain": "若要快速找既有技能且熟悉公司價值的人，優先查看內部員工資訊系統。"}, {"n": 55, "q": "人力資源管理程序中最重要的環境因素是 ________。", "opts": {"A": "商業環境", "B": "自然環境", "C": "法律環境", "D": "科學社群"}, "answer": "C", "tag": "人力資源", "explain": "題庫答案把法律環境列為 HRM 最重要的環境因素。"}, {"n": 56, "q": "下列何者「不是」有效薪酬制度的結果？", "opts": {"A": "維持員工動機", "B": "吸引優秀人才", "C": "使勞動力更高度工會化", "D": "留住優秀人才"}, "answer": "C", "tag": "薪酬", "explain": "有效薪酬制度應吸引、留任並激勵人才；『更高度工會化』不是其目標成果。"}, {"n": 57, "q": "人資管理者要準確估計組織的人力需求，應評估下列哪一項？", "opts": {"A": "就業與失業統計", "B": "組織產品的需求", "C": "整體經濟狀況", "D": "競爭者表現"}, "answer": "B", "tag": "人力規劃", "explain": "產品需求會直接影響需要多少人力，因此是估算人力需求的重要依據。"}, {"n": 58, "q": "360 度回饋與其他績效評估方法不同之處，在於它包含 ________。", "opts": {"A": "書面短文", "B": "員工主管的回饋", "C": "誠實的回饋", "D": "所有與該員工互動者的回饋"}, "answer": "D", "tag": "績效評估", "explain": "360 度回饋的特色是來自多方、所有與員工互動者的回饋。"}, {"n": 59, "q": "下列皆為新進員工導入（orientation）的目標，除了 ________。", "opts": {"A": "降低焦慮", "B": "讓員工熟悉工作", "C": "介紹同事", "D": "討論薪資與福利"}, "answer": "D", "tag": "新人導入", "explain": "題庫認為導入重點在降低焦慮、熟悉工作與同事；薪資福利討論不是此題列的核心目標。"}, {"n": 60, "q": "在下列選項中，評估訓練計畫最好的方式是看 ________。", "opts": {"A": "受訓者自認學到多少", "B": "訓練方法成本多高", "C": "受訓者實際工作績效", "D": "受訓者記住多少資訊"}, "answer": "C", "tag": "訓練評估", "explain": "最能驗證訓練是否有效的是受訓後的實際工作績效。"}, {"n": 61, "q": "下列何者代表產品的功能，以及擁有該產品所帶來的情感滿足？", "opts": {"A": "特色（Features）", "B": "需求", "C": "利益／效益（Benefits）", "D": "安全裝置", "E": "保證"}, "answer": "C", "tag": "產品", "explain": "題幹把功能與擁有產品的情感滿足合在一起，題庫答案為 Benefits。"}, {"n": 62, "q": "組織使用什麼來與客戶建立更好、更強的資訊連結？", "opts": {"A": "顧客關係管理（CRM）", "B": "資料倉儲", "C": "工業行銷", "D": "占有效用", "E": "資料探勘"}, "answer": "A", "tag": "CRM", "explain": "建立更強的客戶資訊連結＝Customer Relationship Management。"}, {"n": 63, "q": "行銷人員必須辨識組織邊界外、可能影響行銷方案的因素。這稱為 ________。", "opts": {"A": "品牌競爭", "B": "外部環境", "C": "資料探勘", "D": "競爭環境", "E": "國際競爭"}, "answer": "B", "tag": "行銷環境", "explain": "組織邊界之外會影響行銷方案的因素，統稱 external environment。"}, {"n": 64, "q": "與產品相關的一整組利益與特色，稱為什麼？", "opts": {"A": "產品組合", "B": "特殊套裝", "C": "服務組合", "D": "便利性", "E": "價值套組（Value package）"}, "answer": "E", "tag": "產品", "explain": "題庫把產品的一整組利益與特色稱為 value package。"}, {"n": 65, "q": "一群彼此密切相關，或銷售給同一顧客群的產品，稱為 ________。", "opts": {"A": "產品線（Product line）", "B": "特殊產品", "C": "產品組合", "D": "便利組合", "E": "生產組合"}, "answer": "A", "tag": "產品線", "explain": "一群彼此密切相關或賣給同一顧客群的產品＝Product line。"}, {"n": 66, "q": "下列何者是能提高顧客滿意度的有形與無形特徵？", "opts": {"A": "便利性", "B": "特色（Features）", "C": "獎勵", "D": "利益（Benefits）", "E": "績效"}, "answer": "B", "tag": "產品特色", "explain": "題庫把提高顧客滿意度的有形與無形特徵對應到 Features。"}, {"n": 67, "q": "公司透過自己擁有的銷售據點系統來配送商品，使用的是哪一種配銷通路？", "opts": {"A": "直接配銷", "B": "零售配銷", "C": "批發配銷", "D": "代理商配銷", "E": "經紀商配銷"}, "answer": "A", "tag": "配銷", "explain": "透過公司自己擁有的銷售據點系統＝Direct distribution。"}, {"n": 68, "q": "若生產者希望產品在銷售過程中獲得促銷優勢與更多關注，應採用哪一種配銷方式？", "opts": {"A": "選擇性配銷（Selective）", "B": "衝突式", "C": "獨家配銷", "D": "密集配銷", "E": "領導式"}, "answer": "A", "tag": "配銷", "explain": "題庫答案為 Selective distribution；重點是挑選部分通路以取得較佳銷售注意。"}, {"n": 69, "q": "製造商只授權極少數零售商或批發商銷售產品，稱為哪一種配銷？", "opts": {"A": "密集配銷", "B": "直接通路配銷", "C": "銷售代理配銷", "D": "獨家配銷（Exclusive）", "E": "選擇性配銷"}, "answer": "D", "tag": "配銷", "explain": "只授權極少數零售或批發商＝Exclusive distribution。"}, {"n": 70, "q": "下列何者最能描述「配銷通路（distribution channel）」？", "opts": {"A": "把產品賣給其他企業，再由其轉售給消費者的中間商群體", "B": "讓產品從生產者流向消費者的相互依賴企業網絡", "C": "在決定成員角色與報酬時最有權力的通路成員", "D": "蒐集買賣雙方資訊的網路配銷通路", "E": "透過推薦顧客取得佣金的賣方網絡"}, "answer": "B", "tag": "配銷通路", "explain": "配銷通路是產品從生產者到消費者之間，相互依賴的企業網絡。"}];
const podcast = [{"title": "開場｜先抓考試結構", "text": "早安。這份複習只抓最可能幫你拿分的東西。題庫說明是問答題四題占四成，選擇題二十題占六成。問答題會從規劃、組織、領導、控制四大管理功能中抽三個主題，再從企業環境或企業功能抽一題。所以第一優先，是把四大管理功能說得完整；第二優先，才是用選擇題補細節。"}, {"title": "第一段｜四大管理功能", "text": "四大管理功能依序是規劃、組織、領導、控制。規劃是設定目標、制定策略與發展計畫；組織是決定需要做什麼、如何做、由誰去做；領導是影響、激勵並處理與人有關的事務；控制是監督活動，確保工作依計畫進行。你可以把它記成：先想要去哪裡，再安排誰來做，接著帶人去做，最後檢查有沒有做到。"}, {"title": "第二段｜規劃", "text": "規劃的正式定義，是定義組織目標、建立達成目標的整體策略，並發展全面性計畫，以整合與協調活動。規劃有四個重要功能：提供方向、降低不確定性、減少資源重疊與浪費、建立控制指標。計畫 Plans 是達成目標的一系列方案；目標 Goals 是組織預期的成果。"}, {"title": "規劃｜策略性與戰術性", "text": "策略性規劃偏長期、範圍廣、方向性高，通常由高階管理者主導；戰術性規劃偏短期、範圍較局部、內容更具體，負責把策略轉化成部門行動。考問答時可以寫：兩者差異主要在時間幅度、使用廣度、明確性與管理層級。"}, {"title": "規劃｜SMART、MBO、SWOT", "text": "好的目標符合 SMART：Specific 明確、Measurable 可衡量、Attainable 可達成、Relevant 相關、Time-bound 有期限。MBO 目標管理則強調清楚的目標、參與式決策、明確期限與定期績效回饋。SWOT 裡，S 優勢與 W 劣勢屬於內部，O 機會與 T 威脅屬於外部。"}, {"title": "規劃｜策略", "text": "公司總體策略三大類是成長、穩定、更新。成長策略可記四個方向：集中、垂直整合、水平整合、多角化。事業競爭策略常見三種：差異化、成本領導、集中。差異化就是提供獨特產品；成本領導就是成為最低成本生產者；集中就是鎖定特定市場區隔。標竿管理則是以相關指標中的最佳對象為依據，指導公司的目標與行動。"}, {"title": "第三段｜組織", "text": "組織是把人與事安排協調，以達成目標。組織設計六大元素：專業分工、部門化、權責劃分、控制幅度、集權與分權、正式化。專業分工是把工作拆成不同任務；部門化則是把相關工作重新組合，例如功能別、產品別、顧客別或地區別。"}, {"title": "組織｜指揮鏈與權責", "text": "指揮鏈是由上到下的直線職權關係。指揮統一原則是，一名員工原則上只對一位管理者負責。職權 Authority 是因管理職位而產生的權利；職責 Responsibility 是因職位而應承擔的責任。控制幅度則是管理者可以有效指揮的員工數目。工作非常複雜、員工能力不足時，不適合過大的控制幅度。"}, {"title": "組織｜矩陣式與機械有機", "text": "矩陣式組織有雙重指揮鏈，同時結合功能與產品或專案。優點是能共享資源、連結相互依賴的工作；缺點是兩條指揮線可能衝突，員工無所適從。機械式組織通常高度專業化、正式化、集權，適合較穩定環境；有機式組織較分權、彈性高，適合創新與不確定環境。"}, {"title": "第四段｜領導與權力", "text": "領導是影響他人朝預期目標邁進的過程。五種權力來源一定要背：法制權，來自職位；強制權，來自懲處或控制；獎賞權，來自獎金升遷等獎賞；專家權，來自專業與特殊知識；參照權，來自個人特質或令人敬佩的影響力。"}, {"title": "領導｜三大研究路線", "text": "領導研究可分成特質論、行為論、情境或權變論。特質論找的是領導者有哪些特徵；行為論找的是有效領導者做了什麼；權變論的核心則是沒有一種領導方法在所有情境都最好，必須看領導風格與情境是否適配。"}, {"title": "領導｜費德勒", "text": "費德勒權變模型假設領導風格相對固定。如果風格與情境不合，不是要求領導者硬改風格，而是更換領導者或改變情境。三個重要情境因素是：領導者與成員關係、任務結構、職權。情境非常有利或非常不利時，任務導向較有效；中間情境偏關係導向。"}, {"title": "領導｜情境領導與路徑目標", "text": "情境領導理論強調部屬成熟度，也就是能力加意願。低能力低意願需要高指導；低能力高意願需要較多教導與支持；高能力低意願適合參與；高能力高意願則可以授權。路徑目標理論則說，領導者要指出達成目標的路徑，並依情境選擇指導、支援、參與或成就導向。"}, {"title": "第五段｜控制", "text": "控制是一種衡量、比較與修正的管理程序，目的在確保組織目標達成。控制程序只有三步：第一，衡量實際績效；第二，比較實際績效與預設標準；第三，採取管理行動。這三步非常容易出問答題。"}, {"title": "控制｜四種績效資訊", "text": "衡量績效有四種常見資訊來源。個人觀察是第一手資料，但可能主觀又費時。統計報告量化、客觀、便於分析，但可能忽略非量化因素。口頭報告快速而且有互動。書面報告最正式、最完整，也方便後續查找。"}, {"title": "控制｜事前、即時、事後", "text": "依控制發生時間，可分三種。事前控制 feedforward，是預測問題並先採預防措施；即時控制 concurrent，是工作進行中同步監督與修正；事後控制 feedback，是問題發生、產出完成後再矯正。記憶口訣：事前先防、即時邊做邊改、事後做完再改。"}, {"title": "第六段｜企業倫理與社會責任", "text": "題庫在企業倫理部分的關鍵字包括：書面道德準則、對員工的倫理、利害關係人與主動型社會責任。書面準則用來正式表達組織重視的價值與原則。利害關係人是會影響組織或受組織影響的個人、群體與組織。題庫中，真誠主動尋找改善社會福祉機會的企業，屬於 proactive 主動型立場。"}, {"title": "第七段｜人力資源", "text": "人資題庫要抓幾個詞。工作分析是蒐集職位的任務與需求；工作說明書描述工作本身要做什麼；工作規範描述任職者需要具備什麼條件。三百六十度回饋的特色是來自所有與員工互動的人。訓練是否有效，最有力的證據不是學員說學到多少，而是實際工作績效有沒有改善。"}, {"title": "第八段｜行銷", "text": "行銷題庫最容易出名詞辨識。CRM 是顧客關係管理，用來建立更強的客戶資訊連結。Product line 產品線，是一群彼此密切相關或賣給相同顧客群的產品。直接配銷是公司透過自己的銷售據點配送；獨家配銷是只授權極少數零售商或批發商。配銷通路則是產品從生產者到消費者之間，相互依賴的企業網絡。"}, {"title": "結尾｜最後一輪背誦", "text": "最後快速複誦十個點。第一，四大管理功能：規劃、組織、領導、控制。第二，SWOT：SW 內部、OT 外部。第三，公司總體策略：成長、穩定、更新。第四，成長方向：集中、垂直、水平、多角化。第五，矩陣式組織：雙重指揮鏈。第六，五種權力：法制、強制、獎賞、專家、參照。第七，費德勒：風格固定，不合就改情境或換領導者。第八，情境領導 readiness 等於能力加意願。第九，控制三步：衡量、比較、行動。第十，事前、即時、事後控制：先防、邊改、做完再改。今天起床後先聽完這一輪，再做二十題模擬考，就能知道哪個章節需要補。"}];

let current=[], answered=0, correct=0, mode='practice', selected={}, flashDeck=[], flashIndex=0, flashBack=false;
const wrongKey='biz_midterm_wrong_v3';
function getWrong(){try{return JSON.parse(localStorage.getItem(wrongKey)||'[]')}catch(e){return []}}
function saveWrong(arr){localStorage.setItem(wrongKey,JSON.stringify([...new Set(arr)]));updateWrongSummary();}
function updateWrongSummary(){
 const w=getWrong();
 document.getElementById('wrongSummary').innerHTML = w.length ? `目前累積 <b>${w.length}</b> 題錯題：${w.join('、')}。可按「只做錯題」重練。` : '目前還沒有錯題紀錄。答錯後會自動記在這支裝置上。';
}
function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function setMode(m){
 mode=m; selected={};
 document.getElementById('practiceTab').classList.toggle('active',m==='practice');
 document.getElementById('examTab').classList.toggle('active',m==='exam');
 document.getElementById('submitExam').style.display=m==='exam'?'inline-block':'none';
 renderQuiz(20);
}
function startWrongMode(){
 const ids=getWrong();
 if(!ids.length){document.getElementById('score').textContent='目前沒有錯題，先做一回 20 題吧。';return;}
 mode='practice';
 document.getElementById('practiceTab').classList.add('active');
 document.getElementById('examTab').classList.remove('active');
 document.getElementById('submitExam').style.display='none';
 renderQuizFrom(questions.filter(q=>ids.includes(q.n)));
}
function renderQuiz(n){renderQuizFrom(shuffle(questions).slice(0,n));}
function renderQuizFrom(arr){
 current=[...arr]; answered=0;correct=0;selected={};
 document.getElementById('score').textContent=mode==='exam'?`模擬考：共 ${current.length} 題，作答後按「交卷看成績」。`:`0 / ${current.length} 已作答；答對 0 題`;
 const box=document.getElementById('quizbox'); box.innerHTML='';
 current.forEach((q,idx)=>{
   const d=document.createElement('div');d.className='qcard';d.id='qcard-'+idx;
   let opts=Object.entries(q.opts).map(([k,v])=>`<button class="opt" data-k="${k}" onclick="choose(this,${idx})"><b>${k})</b> ${escapeHtml(v)}</button>`).join('');
   d.innerHTML=`<div class="qmeta"><span class="small">題庫第 ${q.n} 題</span><span class="tag">${escapeHtml(q.tag)}</span></div><b>${idx+1}. ${escapeHtml(q.q)}</b><div>${opts}</div><div class="answer">正確答案：${q.answer}</div><div class="explain"><b>這題在考：</b>${escapeHtml(q.tag)}<br>${escapeHtml(q.explain)}</div>`;
   box.appendChild(d);
 });
 updateWrongSummary();
}
function choose(btn,idx){
 const card=btn.closest('.qcard'), q=current[idx], pick=btn.dataset.k;
 if(mode==='exam'){
   selected[idx]=pick;
   [...card.querySelectorAll('.opt')].forEach(b=>b.style.outline='');
   btn.style.outline='2px solid #2563eb';
   answered=Object.keys(selected).length;
   document.getElementById('score').textContent=`模擬考：已作答 ${answered} / ${current.length} 題；完成後按「交卷看成績」。`;
   return;
 }
 if(card.dataset.done)return;
 card.dataset.done='1';answered++;
 [...card.querySelectorAll('.opt')].forEach(b=>{
   if(b.dataset.k===q.answer)b.classList.add('correct');
   else if(b===btn)b.classList.add('wrong');
   b.disabled=true;
 });
 const w=getWrong();
 if(pick===q.answer){correct++; saveWrong(w.filter(n=>n!==q.n));}
 else {saveWrong([...w,q.n]);}
 card.querySelector('.answer').classList.add('show');
 card.querySelector('.explain').classList.add('show');
 document.getElementById('score').textContent=`${answered} / ${current.length} 已作答；答對 ${correct} 題（${Math.round(correct/answered*100)}%）`;
}
function submitExam(){
 if(mode!=='exam')return;
 let c=0, wrong=getWrong();
 current.forEach((q,idx)=>{
   const card=document.getElementById('qcard-'+idx), pick=selected[idx];
   [...card.querySelectorAll('.opt')].forEach(b=>{
     if(b.dataset.k===q.answer)b.classList.add('correct');
     else if(b.dataset.k===pick && pick!==q.answer)b.classList.add('wrong');
     b.disabled=true;
   });
   card.querySelector('.answer').classList.add('show');
   card.querySelector('.explain').classList.add('show');
   if(pick===q.answer){c++; wrong=wrong.filter(n=>n!==q.n)} else if(pick){wrong.push(q.n)}
 });
 saveWrong(wrong); correct=c;
 const pct=Math.round(c/current.length*100);
 document.getElementById('score').innerHTML=`交卷完成：<b>${c} / ${current.length}</b>，得分率 <b>${pct}%</b>。${pct>=80?'已經很穩，接著只刷錯題。':pct>=60?'有基本盤，優先把錯題章節補起來。':'先回到四大管理功能，再重做一回。'}`;
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}

